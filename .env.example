# Postgres 14+ (recomendado 16). En Supabase: Project Settings > Database > Connection string.
# DATABASE_URL = conexion agrupada (pooler, puerto 6543) para runtime. Agrega ?pgbouncer=true.
# DIRECT_URL   = conexion directa (puerto 5432), solo la usa Prisma para migrate/introspect.
# En local (sin Supabase) ambas pueden apuntar al mismo Postgres directo.
DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/medicare_referrals?schema=public"
DIRECT_URL="postgresql://USUARIO:CLAVE@localhost:5432/medicare_referrals?schema=public"

# 32+ bytes aleatorios (ej: openssl rand -base64 48). Firma la cookie rf_session.
SESSION_SECRET=""
# Solo durante una rotacion de SESSION_SECRET (se usa unicamente para verificar).
SESSION_SECRET_PREVIOUS=""

# URL publica de la app; se compara con el header Origin en POST/PUT/PATCH/DELETE.
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/New_York"

# Bearer token para /api/cron/notifications
CRON_SECRET=""

# Contrasena inicial de los usuarios del seed (solo dev/staging). Minimo 10 caracteres.
SEED_DEFAULT_PASSWORD=""

# Opcional: email generico de aviso al productor (sin datos del paciente)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
